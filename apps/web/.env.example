# Public site URL used for canonical, OG, sitemap, robots
NEXT_PUBLIC_SITE_URL=https://rozpost.com

# Meta integration mode: mock (local smoke) | live (Instagram Business Login)
META_MODE=mock
NEXT_PUBLIC_META_MODE=mock

# Live Instagram OAuth start (used when META_MODE=live and Spring URL unset)
# NEXT_PUBLIC_INSTAGRAM_OAUTH_START_URL=https://api.rozpost.com/api/v1/oauth/instagram/start

# Spring Boot API — when set, web BFF forwards /api/v1/* upstream
# SPRING_API_URL=http://localhost:8080
