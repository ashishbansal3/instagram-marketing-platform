# Public site URL used for canonical, OG, sitemap, robots
NEXT_PUBLIC_SITE_URL=https://rozpost.com

# Production shape: live. Use mock only for local smoke without Meta.
META_MODE=live
NEXT_PUBLIC_META_MODE=live

