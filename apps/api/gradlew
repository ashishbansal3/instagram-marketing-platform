#!/usr/bin/env sh
set -e
DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
if command -v gradle >/dev/null 2>&1; then
  # Prefer a modern Gradle (8+) if present; else use wrapper jar.
  MAJOR=$(gradle -v 2>/dev/null | awk '/Gradle /{print $2}' | cut -d. -f1)
  if [ -n "$MAJOR" ] && [ "$MAJOR" -ge 8 ] 2>/dev/null; then
    exec gradle -p "$DIR" "$@"
  fi
fi
exec java -cp "$DIR/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
