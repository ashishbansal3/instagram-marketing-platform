# RozPost env template — copy locally (gitignored .env) or set in host secret store / AWS SSM.
# Never commit real credentials. Compose works WITHOUT .env (built-in local defaults).
#   ./scripts/bootstrap-env.sh   # or: cp .env.example .env
#
# Local compose defaults when unset: POSTGRES_*=rozpost, S3_BUCKET=rozpost-media,
# WEBHOOK_VERIFY_TOKEN=local-verify, MOCK_AUTO_ENHANCE=false, MinIO minioadmin.

# --- Core ---
META_MODE=mock
APP_ENV=local
LOG_LEVEL=INFO
AWS_REGION=ap-south-1

# AES-256-GCM for Meta tokens at rest (base64-encoded 32 raw bytes). Required in staging/production.
TOKEN_ENCRYPTION_KEY=

# --- Postgres (local compose OR Amazon RDS) — names match docker-compose defaults ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rozpost
POSTGRES_USER=rozpost
# Local compose falls back to "rozpost" when empty; leave empty for AWS Secrets Manager.
POSTGRES_PASSWORD=
DATABASE_URL=jdbc:postgresql://postgres:5432/rozpost
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/rozpost
SPRING_DATASOURCE_USERNAME=rozpost
SPRING_DATASOURCE_PASSWORD=
# Set false on long-running replicas after pre-deploy migrate (see scripts/pre-deploy-migrate.sh)
SPRING_FLYWAY_ENABLED=true

# --- Redis (local compose OR Amazon ElastiCache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# --- Object storage ---
# Local: MinIO via docker-compose (path-style); bucket must match minio-init (rozpost-media).
# AWS production: real S3 bucket; leave S3_ACCESS_KEY/S3_SECRET_KEY empty and use the ECS task IAM role.
S3_BUCKET=rozpost-media
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Local MinIO overrides (compose sets these when running locally):
# S3_ENDPOINT=http://minio:9000
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=http://localhost:9000/rozpost-media
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# Key layout (app convention): {tenantId}/{postId}/...

# --- API ---
API_PORT=8080
PORT=8080
WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
INTERNAL_API_TOKEN=
PUBLISH_QUOTA_PER_DAY=25
# false = real media-worker + Remotion path (required for e2e-smoke). true = simulation short-circuit only.
MOCK_AUTO_ENHANCE=false
FIXTURE_PERMALINK=https://www.instagram.com/p/MOCK_ROZPOST_POSTED/
MOCK_MEDIA_PATH=fixtures/sample-salon.jpg
NOTIFY_API_BASE_URL=
API_BASE_URL=
META_GRAPH_ACCESS_TOKEN=

# --- Onboarding website + Google Business Profile ---
API_PUBLIC_BASE_URL=http://localhost:8080
SITE_LOCAL_ROOT=./data/sites
WEBSITE_USE_LLM=false
WEBSITE_GBP_JOB_POLL_MS=1500
# Live GBP only (leave empty in mock/local). Store in Secrets Manager in production.
GBP_ACCESS_TOKEN=
GBP_ACCOUNT_NAME=
GBP_API_BASE=https://mybusinessbusinessinformation.googleapis.com/v1

# --- Web (Next.js) ---
# Browser-facing API base. Server-side BFF uses SPRING_API_URL (compose: http://api:8080).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_META_MODE=mock
NEXT_PUBLIC_INSTAGRAM_OAUTH_START_URL=
SPRING_API_URL=http://api:8080
WEB_PORT=3000

# --- Remotion ---
REMOTION_PORT=3100
REMOTION_SERVICE_URL=
REMOTION_BASE_URL=
REMOTION_INTERNAL_TOKEN=
REMOTION_MAX_CONCURRENT=2
REMOTION_RENDER_TIMEOUT_MS=120000

# --- Meta live credentials (only when META_MODE=live; store in Secrets Manager) ---
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_IG_USER_ID=
META_IG_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
META_IG_APP_ID=
META_IG_APP_SECRET=
META_IG_REDIRECT_URI=

# --- Observability (optional) ---
SENTRY_DSN=
LOG_SINK_URL=

# --- Workers ---
WORKER_MEDIA_CONCURRENCY=2
WORKER_PUBLISH_CONCURRENCY=1
WORKER_PORT=8081
WORKER_PUBLISH_PORT=8082
MEDIA_WORK_DIR=/tmp/media-work
MEDIA_ALLOW_MOCK_FALLBACK=true
MEDIA_MAX_ATTEMPTS=5
SHEDLOCK_ENABLED=true
WA_MOCK_ENABLED=true

# --- Optional AI enhance (empty => mock enhance when MEDIA_ALLOW_MOCK_FALLBACK=true) ---
PHOTOROOM_API_KEY=
FAL_API_KEY=
KLING_API_KEY=
