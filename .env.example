# --- Core ---
META_MODE=mock
APP_ENV=local
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rozpost
POSTGRES_USER=rozpost
POSTGRES_PASSWORD=rozpost
DATABASE_URL=jdbc:postgresql://postgres:5432/rozpost

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- Object storage (MinIO / S3 / R2) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rozpost-media
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/rozpost-media

# --- API ---
API_PORT=8080
WEBHOOK_VERIFY_TOKEN=local-verify
META_APP_SECRET=
INTERNAL_API_TOKEN=
# base64-encoded 32-byte key for AES-GCM Meta token vault (local placeholder only)
TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
MOCK_MEDIA_PATH=fixtures/sample-salon.jpg
FIXTURE_PERMALINK=https://www.instagram.com/p/MOCK_ROZPOST_POSTED/
PUBLISH_QUOTA_PER_DAY=25
# false required for real media-worker + Remotion path in e2e-smoke
MOCK_AUTO_ENHANCE=false

# --- Web ---
# Browser-facing API base (public). Server-side BFF uses SPRING_API_URL to reach the API container.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
SPRING_API_URL=http://api:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
WEB_PORT=3000
NEXT_PUBLIC_META_MODE=mock

# --- Remotion ---
REMOTION_PORT=3100
REMOTION_SERVICE_URL=http://remotion:3100

# --- Meta live credentials (only when META_MODE=live) ---
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_IG_USER_ID=
META_IG_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0

# --- Observability (optional) ---
SENTRY_DSN=
LOG_SINK_URL=

# --- Workers ---
WORKER_MEDIA_CONCURRENCY=2
WORKER_PUBLISH_CONCURRENCY=1
MEDIA_ALLOW_MOCK_FALLBACK=true
WA_MOCK_ENABLED=true
