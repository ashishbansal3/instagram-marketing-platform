# --- Core ---
META_MODE=mock
APP_ENV=local
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=imp
POSTGRES_USER=imp
POSTGRES_PASSWORD=imp
DATABASE_URL=jdbc:postgresql://postgres:5432/imp

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- Object storage (MinIO / S3 / R2) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=imp-media
S3_FORCE_PATH_STYLE=true

# --- API ---
API_PORT=8080
WEBHOOK_VERIFY_TOKEN=demo-verify
META_APP_SECRET=demo-app-secret
INTERNAL_API_TOKEN=demo-internal-token

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
WEB_PORT=3000

# --- Remotion ---
REMOTION_PORT=3100
REMOTION_SERVICE_URL=http://remotion:3100

# --- Meta live credentials (only when META_MODE=live) ---
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_IG_USER_ID=
META_IG_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0

# --- Workers ---
WORKER_MEDIA_CONCURRENCY=2
WORKER_PUBLISH_CONCURRENCY=1

# --- Optional AI enhance (empty => mock enhance for offline demo) ---
PHOTOROOM_API_KEY=
FAL_API_KEY=
WORKER_PORT=8081
MEDIA_WORK_DIR=/tmp/media-work
REMOTION_BASE_URL=http://localhost:3100
SHEDLOCK_ENABLED=true
MEDIA_ALLOW_MOCK_FALLBACK=true
WA_MOCK_ENABLED=false
KLING_API_KEY=
REMOTION_INTERNAL_TOKEN=
REMOTION_MAX_CONCURRENT=2
MEDIA_MAX_ATTEMPTS=5
